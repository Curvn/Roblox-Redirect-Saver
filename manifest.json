{
  "manifest_version": 3,
  "name": "Roblox Buy Button Redirect",
  "version": "1.0",
  "description": "Replaces the Roblox buy button with a game join button.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://www.roblox.com/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
